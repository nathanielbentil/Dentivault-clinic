APP_NAME="SecureAuth Banking & Security System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ========================================================
# DATABASE CONFIGURATION (Supabase Cloud PostgreSQL)
# ========================================================
DB_CONNECTION=pgsql
DB_HOST=db.wulriexoojidlilizmps.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password-here
DB_SSLMODE=require

# Optional Direct Connection Pooler (Port 6543)
# DB_PORT=6543

# ========================================================
# PASSWORD SECURITY & HMAC PEPPER CONFIGURATION
# (Server-side secrets, NEVER stored in the database)
# ========================================================
CURRENT_PEPPER_VERSION=v1
PEPPER_V1=replace-with-64-character-random-hex-pepper-v1
# PEPPER_V2=future-pepper-for-zero-downtime-rotation

# Argon2id Parameters (OWASP / NIST Recommended)
ARGON2ID_MEMORY_COST=65536
ARGON2ID_TIME_COST=4
ARGON2ID_THREADS=2

# ========================================================
# SESSION & COOKIE HARDENING
# ========================================================
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ========================================================
# 2FA (TOTP) & RECOVERY CODE SECURITY
# ========================================================
TWO_FACTOR_ISSUER="SecureAuth Banking"
TWO_FACTOR_WINDOW=1
TWO_FACTOR_RECOVERY_CODES_COUNT=8

# ========================================================
# 3-2-1 BACKUP & AGE ASYMMETRIC ENCRYPTION
# ========================================================
# Age Public Key (Safe on Server - Used to Encrypt Backups)
BACKUP_AGE_PUBLIC_KEY=age1yourpublickeyhere
# Age Private Key is KEPT OFFLINE ONLY (Never in .env or on server)

# Supabase Storage S3-Compatible Cloud Backup Destination
SUPABASE_URL=https://wulriexoojidlilizmps.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key-here
BACKUP_S3_KEY=your-supabase-s3-access-key-id
BACKUP_S3_SECRET=your-supabase-s3-secret-access-key
BACKUP_S3_REGION=eu-west-2
BACKUP_S3_BUCKET=secureauth-backups
BACKUP_S3_ENDPOINT=https://wulriexoojidlilizmps.supabase.co/storage/v1/s3

# ========================================================
# MAIL CONFIGURATION (Local Sandbox via Mailpit)
# ========================================================
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="security@secureauth.bank"
MAIL_FROM_NAME="${APP_NAME}"

# ========================================================
# LOGGING & AUDIT TRAIL
# ========================================================
LOG_CHANNEL=stack
LOG_STACK=single,security
LOG_LEVEL=debug

# ========================================================
# CACHE, QUEUE & STORAGE
# ========================================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=secureauth_
